{
  "version": 1,
  "_readme": "Project-specific pipeline config. Add verify.rules and deploy.targets for this repo. Do not put secrets, hosts, or tracker site URLs in other pack files.",
  "workflows": {
    "feature-development": {
      "source": "text",
      "plan_source": "prd.md",
      "classes": {
        "micro": [
          "developer-agent",
          "tester-agent",
          "devops-agent",
          "retro-agent"
        ],
        "minor": [
          "developer-agent",
          "developer-critic-agent",
          "tester-agent",
          "devops-agent",
          "retro-agent"
        ],
        "feature": [
          "product-manager-agent",
          "ui-designer-agent",
          "@signoff:requirements",
          "architect-agent",
          "@signoff:architect",
          "ba-agent",
          "ba-critic-agent",
          "@signoff:ba",
          "@waves",
          "tester-agent",
          "devops-agent",
          "retro-agent"
        ]
      },
      "skips": {
        "skip_telemetry": true
      }
    },
    "jira-story": {
      "source": "jira",
      "plan_source": "intake.md",
      "default_change_class": "feature",
      "chain": [
        "intake-agent",
        "@signoff:requirements",
        "architect-agent",
        "@signoff:architect",
        "ba-agent",
        "ba-critic-agent",
        "@signoff:ba",
        "@waves",
        "tester-agent",
        "devops-agent",
        "retro-agent"
      ],
      "skips": {
        "skip_pm": true,
        "skip_ui_designer": true,
        "skip_telemetry": true
      }
    },
    "jira-epic": {
      "source": "jira",
      "plan_source": "epic-plan.md",
      "default_change_class": "feature",
      "chain": [
        "intake-agent",
        "@signoff:requirements",
        "architect-agent",
        "@signoff:architect",
        "ba-agent",
        "ba-critic-agent",
        "@signoff:ba",
        "@waves",
        "tester-agent",
        "devops-agent",
        "retro-agent"
      ],
      "skips": {
        "skip_pm": true,
        "skip_ui_designer": true,
        "skip_telemetry": true
      }
    },
    "ask": {
      "source": "text",
      "chain": [],
      "skips": {}
    },
    "repo-assessment": {
      "source": "text",
      "chain": [],
      "skips": {}
    },
    "test-knowledge-bootstrap": {
      "source": "text",
      "chain": [
        "knowledge-curator-agent"
      ],
      "skips": {
        "skip_pm": true,
        "skip_ba": true,
        "skip_ba_critic": true,
        "skip_architect": true,
        "skip_telemetry": true,
        "skip_developer_critic": true,
        "skip_tester": true
      }
    },
    "jira-bug": {
      "source": "jira",
      "plan_source": "rca.md",
      "default_change_class": "minor",
      "chain": [
        "intake-agent",
        "bug-analyst-agent",
        "developer-agent",
        "developer-critic-agent",
        "tester-agent",
        "devops-agent",
        "retro-agent"
      ],
      "skips": {
        "skip_pm": true,
        "skip_ba": true,
        "skip_ba_critic": true,
        "skip_architect": true,
        "skip_ui_designer": true,
        "skip_telemetry": true,
        "skip_developer_critic": false
      },
      "run_tester": true
    }
  },
  "waves": {
    "_note": "@waves expands to this per-child chain, read from features/{slug}/spec-order.md.",
    "child_chain": [
      "developer-agent",
      "developer-critic-agent"
    ]
  },
  "intake": {
    "jira": {
      "enabled": true,
      "key_pattern": "\\b[A-Z][A-Z0-9_]+-[0-9]+\\b",
      "mcp_namespaces": [],
      "tools": {
        "issue": "getJiraIssue",
        "search": "searchJiraIssuesUsingJql"
      },
      "epic_children_jql": "parent = {KEY} ORDER BY rank ASC",
      "max_children": 20,
      "issue_type_map": {
        "story": "jira-story",
        "task": "jira-story",
        "sub-task": "jira-story",
        "improvement": "jira-story",
        "bug": "jira-bug",
        "defect": "jira-bug",
        "incident": "jira-bug",
        "epic": "jira-epic",
        "initiative": "jira-epic",
        "default": "jira-story"
      },
      "include_comments": false,
      "write_back": false
    }
  },
  "product": {
    "_note": "artifact_dir is the only tree analysis agents may write to; everything else is product source.",
    "artifact_dir": "features/",
      "readonly_agents": [
      "intake-agent",
      "product-manager-agent",
      "ui-designer-agent",
      "architect-agent",
      "ba-agent",
      "ba-critic-agent",
      "bug-analyst-agent",
      "telemetry-agent",
      "knowledge-curator-agent",
      "test-designer-agent"
    ]
  },
  "test_design": {
    "_note": "Opt-in. pipeline-kit knowledge init sets enabled true. Absent or false keeps the current ladder. Do not add test-designer-agent to class chains.",
    "enabled": false,
    "graph_provider": "graphify-cli",
    "graph_path": "graphify-out/graph.json",
    "design_only": true,
    "playwright": false,
    "playwright_dir": "automation-tests"
  },
  "architecture_diagrams": {
    "_note": "Opt-in. pipeline-kit plugins install archify sets enabled true. Absent or false keeps mermaid-only architecture. Do not add a diagram agent to class chains.",
    "enabled": false,
    "provider": "archify-skill",
    "version": "v2.16.0",
    "fallback": "mermaid",
    "visual_check": "when-available"
  },
  "agent_observability": {
    "_note": "Opt-in agent-run observability. Distinct from telemetry-agent (customer app events). Secrets stay in the environment.",
    "enabled": false,
    "adapter": "langfuse",
    "sample_rate": 1.0,
    "redact": [".env", "*secret*", "*credential*"],
    "max_field_chars": 8000,
    "flush_on": ["subagentStop", "sessionEnd"],
    "dataset": "pipeline-kit-agent-runs",
    "retention_days": 14
  },
  "verify": {
    "_note": "Add path-substring reminders for this repo after install. Optional expect is a regex the scorer uses for integrity checks.",
    "rules": []
  },
  "orchestrator": {
    "_note": "Model choice for orchestrator mode. decider jev asks TypeSafe before each agent. decider fixed skips that call. Secrets stay in TYPESAFE_API_KEY and CURSOR_API_KEY.",
    "decider": "jev",
    "fallback_model": "composer-2.5",
    "models": {
      "steps": {},
      "candidates": [
        "composer-2.5",
        "grok-4.5",
        "grok-4.6",
        "grok-4.7",
        "claude-opus-5",
        "gpt-5.5",
        "gpt-5.6-sol"
      ],
      "cards": {}
    },
    "jev": {
      "model": "jev-latest",
      "min_confidence": 0.5
    }
  },
  "gates": {
    "retry_cap": 2,
    "consult_cap": 1,
    "require_signoff_before_deploy": true,
    "require_planning_signoff_before_build": true,
    "complete_after": "retro-agent"
  },
  "deploy": {
    "_note": "Set targets this repo's deploy runbook understands.",
    "target": "auto",
    "targets": [
      "auto"
    ]
  }
}
