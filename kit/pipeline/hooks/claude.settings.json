{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/before-shell.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/before-read.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/pre-write.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/post-tool-failure.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/subagent-start.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} .pipeline/hooks/subagent-stop.py"
          }
        ]
      }
    ]
  }
}
