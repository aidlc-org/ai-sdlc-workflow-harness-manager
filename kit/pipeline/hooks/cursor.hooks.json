{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/subagent-start.py",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/subagent-stop.py",
        "timeout": 10,
        "loop_limit": 1
      }
    ],
    "beforeShellExecution": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/before-shell.py",
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/before-mcp.py",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/before-read.py",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/pre-write.py",
        "matcher": "Write|StrReplace",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/after-file-edit.py",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "{{PYTHON}} .pipeline/hooks/post-tool-failure.py",
        "timeout": 10
      }
    ]
  }
}
