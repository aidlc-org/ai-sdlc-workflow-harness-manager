{
  "version": 1,
  "agent": "{agent-id}",
  "slug": "{slug}",
  "status": "SUCCESS",
  "updated_at": "{ISO-8601}",
  "inputs": [
    {
      "path": "features/{slug}/pipeline-state.json",
      "role": "pipeline_state"
    },
    {
      "path": "features/{slug}/state/{prior-agent}.json",
      "role": "prior_state"
    }
  ],
  "outputs": [
    {
      "path": "features/{slug}/{artifact}",
      "kind": "{prd|research|architecture|specification|handoff|other}",
      "required": true
    }
  ],
  "reads": [
    {
      "path": "{repo or artifact path}",
      "note": "{what this path proved}"
    }
  ],
  "context": {
    "summary": "",
    "goals": [],
    "concerns": [
      {
        "id": "C-1",
        "severity": "blocking | recorded",
        "audience": "user | pm | none",
        "summary": ""
      }
    ],
    "reuse_candidates": [
      {
        "path": "{existing repo path considered}",
        "note": "{what it covers, or why it did not fit}"
      }
    ],
    "new_dependencies": [
      {
        "name": "{exact package name the installer sees}",
        "why_nothing_existing_works": "{repo / stdlib / platform / installed dep checked, and why each failed}"
      }
    ],
    "next_agent": "{agent-id | signoff-requirements | signoff-architect | signoff-ba | stop}",
    "recommend_after_signoff": "{architect-agent | ba-agent | none}",
    "consult_agent": "{ui-designer-agent | none}",
    "consult_reason": "",
    "consult_questions": [],
    "resume_agent": "{architect-agent | ba-agent | none}",
    "next_must_read": [
      "features/{slug}/{artifact}"
    ]
  }
}
